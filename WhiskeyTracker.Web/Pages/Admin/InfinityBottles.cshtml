@page
@model WhiskeyTracker.Web.Pages.Admin.InfinityBottlesModel
@{
    ViewData["Title"] = "Infinity Bottle Migration";
    var sharedCount = Model.Bottles.Count(b => b.IsShared);
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Admin/Index">Admin Dashboard</a></li>
            <li class="breadcrumb-item active">Infinity Bottles</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Infinity Bottle Migration</h1>
        @if (sharedCount > 0)
        {
            <form method="post" asp-page-handler="Migrate">
                <button type="submit" class="btn btn-warning" onclick="return confirm('Give every shared infinity bottle its own whiskey record?');">
                    Migrate All Shared (@sharedCount)
                </button>
            </form>
        }
    </div>

    <p class="text-muted">
        Migrating gives an infinity bottle its own "Living Blend" whiskey record, copies only the
        bottle image, and moves that bottle's tasting notes to the new record. The original whiskey
        and its other bottles are left untouched. "Shared" means other bottles use the same whiskey
        record; the per-row button works for any infinity bottle, shared or not.
    </p>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Bottle</th>
                        <th>Current Whiskey</th>
                        <th>Collection</th>
                        <th>Status</th>
                        <th>New Whiskey Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Bottles.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No infinity bottles found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model.Bottles)
                        {
                            <tr>
                                <td><a asp-page="/Bottles/Infinity" asp-route-id="@b.BottleId">#@b.BottleId</a></td>
                                <td>@b.Brand @b.WhiskeyName</td>
                                <td>@(b.CollectionName ?? "-")</td>
                                <td>
                                    @if (b.IsShared)
                                    {
                                        <span class="badge bg-warning text-dark">Shared with @b.SharedWithBottleCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unshared</span>
                                    }
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="MigrateOne" class="d-flex gap-2"
                                          onsubmit="return confirm('Give this infinity bottle its own whiskey record?');">
                                        <input type="hidden" name="bottleId" value="@b.BottleId" />
                                        <input type="text" name="newName" class="form-control form-control-sm" value="@b.WhiskeyName" maxlength="100" />
                                        <button type="submit" class="btn btn-sm btn-warning text-nowrap">Migrate</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
