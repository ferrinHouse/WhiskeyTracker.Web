@page
@model WhiskeyTracker.Web.Pages.Admin.WhiskeyValuesModel
@using WhiskeyTracker.Web.Services
@{
    ViewData["Title"] = "Clean Up Values";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Clean Up Values</h2>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">Back to Admin</a>
    </div>
    <p class="text-muted">
        Merge spelling variants so the library filters show one value. Every whiskey using a merged value is
        rewritten to the value you keep.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <ul class="nav nav-pills mb-4">
        @foreach (var field in Enum.GetValues<WhiskeyValueField>())
        {
            <li class="nav-item">
                <a class="nav-link @(field == Model.Field ? "active" : "")" asp-page="./WhiskeyValues" asp-route-Field="@field">@field</a>
            </li>
        }
    </ul>

    @if (Model.Preview != null)
    {
        var preview = Model.Preview;
        <div class="card border-primary shadow-sm mb-4" id="merge-preview">
            <div class="card-header bg-primary-subtle text-primary-emphasis">
                <h5 class="mb-0">Confirm merge</h5>
            </div>
            <div class="card-body">
                <p class="mb-2">
                    <strong>@preview.AffectedCount</strong> whiskey(s) will have their @Model.Field.ToString().ToLowerInvariant()
                    changed to <strong>@preview.Target</strong>:
                </p>
                <ul>
                    @foreach (var source in preview.Sources)
                    {
                        <li>@source.Value <span class="text-muted">(@source.Count)</span></li>
                    }
                </ul>
                @if (preview.NewDuplicates.Any())
                {
                    <div class="alert alert-warning" role="alert">
                        <strong>Heads up:</strong> after this merge these whiskeys will have the same brand, name and age,
                        so they will look like duplicates:
                        <ul class="mb-0 mt-2">
                            @foreach (var dup in preview.NewDuplicates)
                            {
                                <li>@dup</li>
                            }
                        </ul>
                    </div>
                }
                <form method="post" asp-page-handler="Merge" class="d-flex gap-2">
                    <input type="hidden" name="Field" value="@Model.Field" />
                    <input type="hidden" name="target" value="@preview.Target" />
                    @foreach (var source in preview.Sources)
                    {
                        <input type="hidden" name="sources" value="@source.Value" />
                    }
                    <button type="submit" class="btn btn-primary">Merge @preview.AffectedCount whiskey(s)</button>
                    <a asp-page="./WhiskeyValues" asp-route-Field="@Model.Field" class="btn btn-outline-secondary">Cancel</a>
                </form>
            </div>
        </div>
    }

    <div class="card shadow-sm border-0 bg-body-tertiary mb-4">
        <div class="card-header bg-warning-subtle text-warning-emphasis">
            <h5 class="mb-0">Possible duplicates (@Model.Suggestions.Count)</h5>
        </div>
        <div class="card-body">
            @if (!Model.Suggestions.Any())
            {
                <p class="text-muted mb-0">No likely spelling variants found for @Model.Field.</p>
            }
            else
            {
                <p class="small text-muted">Pick the value to keep. The ticked values are merged into it.</p>
                @for (var g = 0; g < Model.Suggestions.Count; g++)
                {
                    var group = Model.Suggestions[g];
                    <form method="post" asp-page-handler="Preview" class="border rounded p-3 mb-3 bg-body">
                        <input type="hidden" name="Field" value="@Model.Field" />
                        <table class="table table-sm mb-2 align-middle">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 4rem;">Keep</th>
                                    <th class="text-center" style="width: 4rem;">Merge</th>
                                    <th>Value</th>
                                    <th class="text-end">Whiskeys</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < group.Count; i++)
                                {
                                    var id = $"g{g}v{i}";
                                    <tr>
                                        <td class="text-center">
                                            <input class="form-check-input" type="radio" name="target" value="@group[i].Value" id="@(id)k"
                                                   checked="@(i == 0)" aria-label="Keep @group[i].Value" />
                                        </td>
                                        <td class="text-center">
                                            <input class="form-check-input" type="checkbox" name="sources" value="@group[i].Value" id="@(id)m"
                                                   checked="@(i != 0)" aria-label="Merge @group[i].Value" />
                                        </td>
                                        <td>@group[i].Value</td>
                                        <td class="text-end">@group[i].Count</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Preview merge</button>
                    </form>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 bg-body-tertiary mb-4">
        <div class="card-header">
            <h5 class="mb-0">All @Model.Field values (@Model.Values.Count)</h5>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Preview">
                <input type="hidden" name="Field" value="@Model.Field" />
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-sm-8">
                        <label for="manual-target" class="form-label">Merge the ticked values into</label>
                        <input type="text" class="form-control" id="manual-target" name="target" list="value-options"
                               maxlength="@WhiskeyValueMerge.MaxLength(Model.Field)" placeholder="Pick an existing value or type a new one" />
                        <datalist id="value-options">
                            @foreach (var v in Model.Values.Where(v => v.Value.Length > 0))
                            {
                                <option value="@v.Value"></option>
                            }
                        </datalist>
                    </div>
                    <div class="col-sm-4">
                        <button type="submit" class="btn btn-outline-primary w-100">Preview merge</button>
                    </div>
                </div>
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th style="width: 3rem;"></th>
                                <th>Value</th>
                                <th class="text-end">Whiskeys</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < Model.Values.Count; i++)
                            {
                                var v = Model.Values[i];
                                <tr>
                                    <td>
                                        @if (v.Value.Length > 0)
                                        {
                                            <input class="form-check-input" type="checkbox" name="sources" value="@v.Value" id="all@(i)" />
                                        }
                                    </td>
                                    <td>
                                        @if (v.Value.Length > 0)
                                        {
                                            <label for="all@(i)">@v.Value</label>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">(blank)</span>
                                        }
                                    </td>
                                    <td class="text-end">@v.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        </div>
    </div>
</div>
