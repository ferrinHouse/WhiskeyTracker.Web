@page
@model WhiskeyTracker.Web.Pages.Bottles.IndexModel
@{
    ViewData["Title"] = "Infinity Bottles";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h1 class="display-6 mb-1"><span class="text-primary">♾️</span> Infinity Bottles</h1>
            <p class="text-muted mb-0">Track and manage your living blends, fill levels, and pour compositions.</p>
        </div>
        <div>
            <a asp-page="./Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> New Infinity Bottle
            </a>
        </div>
    </div>

    @if (Model.TotalBottlesCount > 0)
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-4">
                <div class="card shadow-sm border-0 bg-body-tertiary">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-primary-subtle text-primary rounded-circle p-3 me-3">
                            <i class="bi bi-infinity fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Infinity Bottles</div>
                            <div class="fs-4 fw-bold">@Model.TotalBottlesCount</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card shadow-sm border-0 bg-body-tertiary">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-success-subtle text-success rounded-circle p-3 me-3">
                            <i class="bi bi-droplet-half fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Total Volume</div>
                            <div class="fs-4 fw-bold">@Model.TotalVolumeMl <span class="fs-6 fw-normal text-muted">ml</span></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card shadow-sm border-0 bg-body-tertiary">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-info-subtle text-info rounded-circle p-3 me-3">
                            <i class="bi bi-layers-fill fs-4"></i>
                        </div>
                        <div>
                            <div class="text-muted small text-uppercase fw-bold">Total Additions</div>
                            <div class="fs-4 fw-bold">@Model.TotalAdditionsCount <span class="fs-6 fw-normal text-muted">pours</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Filter Bar -->
    <div class="card shadow-sm mb-4 border-0 bg-body-tertiary">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label asp-for="SearchString" class="form-label small fw-bold text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-body border-end-0"><i class="bi bi-search"></i></span>
                        <input asp-for="SearchString" class="form-control bg-body border-start-0" placeholder="Blend name or brand..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label asp-for="CollectionId" class="form-label small fw-bold text-muted">Collection</label>
                    <select asp-for="CollectionId" asp-items="Model.Collections" class="form-select bg-body">
                        <option value="">All My Collections</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="Status" class="form-label small fw-bold text-muted">Status</label>
                    <select asp-for="Status" class="form-select bg-body">
                        <option value="">All Statuses</option>
                        <option value="@WhiskeyTracker.Web.Data.BottleStatus.Opened">Opened</option>
                        <option value="@WhiskeyTracker.Web.Data.BottleStatus.Full">Full</option>
                        <option value="@WhiskeyTracker.Web.Data.BottleStatus.Empty">Empty</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="SortOrder" class="form-label small fw-bold text-muted">Sort By</label>
                    <select asp-for="SortOrder" class="form-select bg-body">
                        <option value="">Name (A to Z)</option>
                        <option value="name_desc">Name (Z to A)</option>
                        <option value="volume_desc">Volume (High to Low)</option>
                        <option value="volume_asc">Volume (Low to High)</option>
                        <option value="components_desc">Most Additions</option>
                        <option value="recent">Recently Added To</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-secondary flex-grow-1">Filter</button>
                    @if (Model.HasFilterActive())
                    {
                        <a asp-page="./Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Bottle Cards List -->
    @if (Model.InfinityBottles.Count == 0)
    {
        @if (Model.HasFilterActive())
        {
            <div class="alert alert-info text-center p-4">
                <i class="bi bi-funnel display-6 d-block mb-2"></i>
                <h5>No Infinity Bottles Matched Your Filters</h5>
                <p class="text-muted mb-3">Try clearing or adjusting your search criteria.</p>
                <a asp-page="./Index" class="btn btn-outline-primary">Reset Filters</a>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm p-5 text-center my-4 bg-body-tertiary">
                <div class="mb-3">
                    <span class="display-3 text-primary">♾️</span>
                </div>
                <h3>No Infinity Bottles Yet</h3>
                <p class="text-muted mx-auto" style="max-width: 540px;">
                    An infinity bottle is a living, ongoing blend created by combining leftover drams from your favorite whiskies into a single decanter. Each pour creates a unique, evolving flavor profile.
                </p>
                <div class="mt-3">
                    <a asp-page="./Create" class="btn btn-primary btn-lg">
                        <i class="bi bi-plus-lg me-1"></i> Create Your First Infinity Bottle
                    </a>
                </div>
            </div>
        }
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var bottle in Model.InfinityBottles)
            {
                var percent = bottle.FillPercentage;
                var progressColor = percent < 15 ? "bg-danger" : percent < 40 ? "bg-warning" : "bg-success";

                <div class="col">
                    <div class="card h-100 shadow-sm border-0 position-relative">
                        <div class="card-header bg-body-tertiary border-0 pb-0 pt-3 px-3 d-flex justify-content-between align-items-start">
                            <div>
                                @if (!string.IsNullOrEmpty(bottle.Brand) && bottle.Brand != "Living Blend")
                                {
                                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.75rem;">@bottle.Brand</small>
                                }
                                <h5 class="card-title mb-1 text-truncate" style="max-width: 220px;" title="@bottle.WhiskeyName">
                                    <a asp-page="./Infinity" asp-route-id="@bottle.BottleId" class="text-decoration-none text-body">
                                        @bottle.WhiskeyName
                                    </a>
                                </h5>
                            </div>
                            <div>
                                @if (bottle.Status == WhiskeyTracker.Web.Data.BottleStatus.Opened)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Opened</span>
                                }
                                else if (bottle.Status == WhiskeyTracker.Web.Data.BottleStatus.Full)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Full</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Empty</span>
                                }
                            </div>
                        </div>

                        <div class="card-body px-3 pt-2">
                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(bottle.ImageFileName))
                                {
                                    <img src="~/images/@bottle.ImageFileName" class="rounded me-3" style="width: 54px; height: 54px; object-fit: cover;" alt="@bottle.WhiskeyName" />
                                }
                                else
                                {
                                    <div class="rounded bg-primary-subtle text-primary d-flex align-items-center justify-content-center me-3" style="width: 54px; height: 54px;">
                                        <i class="bi bi-infinity fs-3"></i>
                                    </div>
                                }
                                <div class="overflow-hidden">
                                    @if (!string.IsNullOrEmpty(bottle.CollectionName))
                                    {
                                        <div class="text-muted small text-truncate">
                                            <i class="bi bi-collection me-1"></i>@bottle.CollectionName
                                        </div>
                                    }
                                    <div class="text-muted small">
                                        <i class="bi bi-layers me-1"></i>@bottle.ComponentCount @(bottle.ComponentCount == 1 ? "addition" : "additions") (@bottle.TotalMlAdded ml)
                                    </div>
                                </div>
                            </div>

                            <!-- Fill level gauge -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Volume</span>
                                    <span class="fw-bold text-body">@bottle.CurrentVolumeMl / @bottle.CapacityMl ml (@percent.ToString("F0")%)</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar @progressColor" role="progressbar" style="width: @percent%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <div class="small text-muted mb-2">
                                <i class="bi bi-clock-history me-1"></i>
                                @if (bottle.LastDateAdded.HasValue)
                                {
                                    <span>Last pour: @bottle.LastDateAdded.Value.ToShortDateString()</span>
                                }
                                else
                                {
                                    <span>No blend additions yet</span>
                                }
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-top-0 pt-0 pb-3 px-3">
                            <div class="d-flex gap-2">
                                <a asp-page="./Infinity" asp-route-id="@bottle.BottleId" class="btn btn-sm btn-primary flex-grow-1" title="View blend recipe and composition">
                                    <i class="bi bi-pie-chart me-1"></i> Blend Details
                                </a>
                                @if (bottle.Status != WhiskeyTracker.Web.Data.BottleStatus.Empty)
                                {
                                    <a asp-page="/Whiskies/QuickPour" asp-route-id="@bottle.BottleId" class="btn btn-sm btn-outline-success" title="Pour a drink from this bottle">
                                        🥃 Pour
                                    </a>
                                    <form method="post" asp-page="/Tasting/Create" asp-page-handler="SingleBottle" class="d-inline">
                                        <input type="hidden" name="bottleId" value="@bottle.BottleId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary" title="Log a tasting note from this bottle">
                                            <i class="bi bi-journal-text"></i> Taste
                                        </button>
                                    </form>
                                }
                                <a asp-page="/Whiskies/EditBottle" asp-route-id="@bottle.BottleId" class="btn btn-sm btn-outline-secondary" title="Edit Bottle Details">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
